from pygame import *


window = display.set_mode((700, 500))
display.set_caption("Game Keren")
background = transform.scale(image.load("playground.jpg"), (700, 500))


#data gambar sprite
x1 = 100
y1 = 300


x2 = 300
y2 = 300


sprite1 = transform.scale(image.load('exercise.png'), (100, 100))
sprite2 = transform.scale(image.load('easter-bunny.png'), (100, 100))
speed = 10

enemy_speed = 2
enemy_side = "left"


x3 = 620
y3 = 400
sprite4 = transform.scale(image.load('treasure.png'), (65, 65))


finish = False

WALL_COLOR = (90, 60, 30)
walls = [
    Rect(220, 0, 20, 350),   
    Rect(400, 150, 20, 350),  
    Rect(550, 0, 20, 350),   
]

#game loop
run = True
clock = time.Clock()
FPS = 60

mixer.init()
mixer.music.load('arka.ogg')
mixer.music.set_volume(0.1)
mixer.music.play(-1)


font.init()
game_font = font.Font(None, 70)
win_text = game_font.render('YOU WIN!', True, (255, 215, 0))
lose_text = game_font.render('YOU LOSE!', True, (180, 0, 0))
money = mixer.Sound('money.ogg')
kick = mixer.Sound('kick.ogg')
result_text = None

while run:
   window.blit(background,(0, 0))
   for w in walls: 
       draw.rect(window, WALL_COLOR, w)
   window.blit(sprite1, (x1, y1))
   window.blit(sprite2, (x2, y2))
   window.blit(sprite4, (x3, y3))

   for e in event.get():
       if e.type == QUIT:
           run = False


   keys_pressed = key.get_pressed()

   new_x1, new_y1 = x1, y1
   if keys_pressed[K_a] and x1 > 5:
       new_x1 -= speed
   if keys_pressed[K_d] and x1 < 595:
       new_x1 += speed
   if keys_pressed[K_w] and y1 > 5:
       new_y1 -= speed
   if keys_pressed[K_s] and y1 < 395:
       new_y1 += speed
   # cek nabrak tembok labirin sebelum posisi diterapkan
   next_rect = Rect(new_x1, new_y1, 100, 100)
   if not any(next_rect.colliderect(w) for w in walls):
       x1, y1 = new_x1, new_y1



   if x2 <= 300:
       enemy_side = "right"
   if x2 >= 700 - 85:
       enemy_side = "left"
   if enemy_side == "left":
       x2 -= enemy_speed
   else:
       x2 += enemy_speed



  

#collision event: text & sound
#cek event collision (sprite1 vs sprite2/sprite3)
   if not finish:
       if Rect(x1, y1, 100, 100).colliderect(Rect(x2, y2, 100, 100)):
           finish = True
           result_text = lose_text
           kick.play()
       elif Rect(x1, y1, 100, 100).colliderect(Rect(x3, y3, 65, 65)):
           finish = True
           result_text = win_text
           money.play()
   else:
       window.blit(result_text, (200, 200))

   display.update()
   clock.tick(FPS)



# hitung posisi tujuan dulu, jangan langsung diterapkan
   